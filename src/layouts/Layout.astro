---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  schema?: Record<string, any>;
  type?: 'website' | 'article' | 'product';
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Migibio (Guangzhou Magic Biotech) — leading manufacturer of POCT veterinary rapid diagnostic equipment and fluorescence immunochromatographic test reagents.',
  ogImage = '/images/default-og.png',
  schema,
  type = 'website',
  canonical,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://migibio.com';
const pageUrl = canonical ? `${siteUrl}${canonical}` : new URL(Astro.url.pathname, siteUrl).href;
const brandTitle = title.includes('Migibio') ? title : `${title} — Migibio`;
const companyName = 'Guangzhou Magic Biotech Co., Ltd.';
const phone = '020-82288812';
const email = 'info@magic-bio.com';
const address = 'G2-601, Najin Technology Industrial Park, No. 39 Ruihe Road, Huangpu District, Guangzhou City, Guangdong Province, China';

const navLinks = [
  { label: 'Home', href: '/' },
  {
    label: 'About Us',
    href: '/about',
    children: [
      { label: 'Introduction', href: '/about' },
      { label: 'History', href: '/history' },
      { label: 'Corporate Identity', href: '/corporate-identity' },
      { label: 'Locations', href: '/locations' },
    ],
  },
  {
    label: 'Equipment',
    href: '/equipment',
    children: [
      { label: 'FIA680 Analyzer', href: '/equipment/FIA680' },
      { label: 'FIA880 Analyzer', href: '/equipment/FIA880' },
    ],
  },
  { label: 'Reagents', href: '/reagents' },
  { label: 'Core Technology', href: '/core-technology' },
  { label: 'Blog', href: '/blog' },
  { label: 'Support', href: '/support' },
  { label: 'News', href: '/news' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Primary Meta -->
    <title>{brandTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="POCT veterinary diagnostic equipment, rapid test reagents, fluorescence immunochromatography, FICT, canine diagnostic test kit, feline diagnostic test kit, FIA680, FIA880" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={brandTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Migibio" />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={`${siteUrl}${ogImage}`} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={brandTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />}

    <meta name="generator" content={Astro.generator} />

    <!-- Schema.org JSON-LD -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <div class="brand-accent"></div>
    <header class="sticky top-0 z-40 border-b border-gray-200/80 bg-white/90 shadow-sm backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2.5" aria-label="Migibio home">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 shadow-sm">
            <img src="/images/favicon.png" alt="" class="h-6 w-6" width="24" height="24" />
          </span>
          <span class="text-lg font-bold tracking-tight text-brand-800">Migibio</span>
        </a>

        <!-- Desktop nav -->
        <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary">
          {navLinks.map((item) => (
            item.children ? (
              <div class="group relative">
                <a href={item.href} class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-brand-50 hover:text-brand-700">
                  {item.label}
                  <svg class="h-4 w-4 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
                </a>
                <div class="invisible absolute left-0 top-full z-50 w-56 -translate-y-1 rounded-xl border border-gray-100 bg-white py-2 opacity-0 shadow-lg shadow-gray-900/5 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                  {item.children.map((child) => (
                    <a href={child.href} class="block px-4 py-2 text-sm text-gray-700 transition-colors hover:bg-brand-50 hover:text-brand-700">{child.label}</a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={item.href} class="rounded-md px-3 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-brand-50 hover:text-brand-700">{item.label}</a>
            )
          ))}
        </nav>

        <div class="flex items-center gap-3">
          <a href="/contact" class="hidden rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700 sm:inline-flex">Request a Quote</a>
          <!-- Mobile menu button -->
          <button id="menu-toggle" type="button" class="inline-flex items-center justify-center rounded-lg p-2 text-gray-700 hover:bg-gray-100 lg:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
            <svg id="menu-icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
            <svg id="menu-icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-gray-100 bg-white lg:hidden">
        <nav class="space-y-1 px-4 py-4 sm:px-6" aria-label="Mobile">
          {navLinks.map((item) => (
            item.children ? (
              <div>
                <p class="px-3 py-2 text-sm font-semibold uppercase tracking-wide text-gray-500">{item.label}</p>
                {item.children.map((child) => (
                  <a href={child.href} class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-brand-50 hover:text-brand-700">{child.label}</a>
                ))}
              </div>
            ) : (
              <a href={item.href} class="block rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-brand-50 hover:text-brand-700">{item.label}</a>
            )
          ))}
          <a href="/contact" class="mt-3 block rounded-lg bg-brand-600 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Request a Quote</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t border-gray-200 bg-gray-900 text-gray-300">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-4 lg:px-8">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600">
              <img src="/images/favicon.png" alt="" class="h-6 w-6" width="24" height="24" />
            </span>
            <span class="text-lg font-bold text-white">Migibio</span>
          </div>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-gray-400">
            Leading manufacturer of POCT veterinary rapid diagnostic equipment and fluorescence immunochromatographic reagents. ISO9001 &amp; GMP certified, exported to 30+ countries.
          </p>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Products</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a href="/equipment/FIA680" class="text-gray-400 transition-colors hover:text-brand-300">FIA680 Analyzer</a></li>
            <li><a href="/equipment/FIA880" class="text-gray-400 transition-colors hover:text-brand-300">FIA880 Analyzer</a></li>
            <li><a href="/reagents" class="text-gray-400 transition-colors hover:text-brand-300">Canine &amp; Feline Reagents</a></li>
            <li><a href="/core-technology" class="text-gray-400 transition-colors hover:text-brand-300">Core Technology</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Company</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a href="/about" class="text-gray-400 transition-colors hover:text-brand-300">About Us</a></li>
            <li><a href="/blog" class="text-gray-400 transition-colors hover:text-brand-300">Blog</a></li>
            <li><a href="/support" class="text-gray-400 transition-colors hover:text-brand-300">Support</a></li>
            <li><a href="/contact" class="text-gray-400 transition-colors hover:text-brand-300">Contact Us</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-800">
        <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 text-xs text-gray-500 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
          <p>&copy; {new Date().getFullYear()} {companyName} — Migibio. All rights reserved.</p>
          <p>Tel: {phone} &nbsp;·&nbsp; Email: {email}</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const openIcon = document.getElementById('menu-icon-open');
      const closeIcon = document.getElementById('menu-icon-close');
      toggle?.addEventListener('click', () => {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        openIcon.classList.toggle('hidden', !isOpen);
        closeIcon.classList.toggle('hidden', isOpen);
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
    </script>
  </body>
</html>

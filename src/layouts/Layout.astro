---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  schema?: Record<string, any>;
  type?: 'website' | 'article' | 'product';
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Migibio (Guangzhou Magic Biotech) — leading manufacturer of POCT veterinary rapid diagnostic equipment and fluorescence immunochromatographic test reagents.',
  ogImage = '/images/default-og.png',
  schema,
  type = 'website',
  canonical,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://migibio.com';
const pageUrl = canonical ? `${siteUrl}${canonical}` : new URL(Astro.url.pathname, siteUrl).href;
const brandTitle = title.includes('Migibio') ? title : `${title} — Migibio`;
const companyName = 'Guangzhou Magic Biotech Co., Ltd.';
const phone = '020-82288812';
const email = 'info@magic-bio.com';
const address = 'G2-601, Najin Technology Industrial Park, No. 39 Ruihe Road, Huangpu District, Guangzhou City, Guangdong Province, China';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <meta name="viewport" content="width=device-width" />

    <!-- Primary Meta -->
    <title>{brandTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="POCT veterinary diagnostic equipment, rapid test reagents, fluorescence immunochromatography, FICT, canine diagnostic test kit, feline diagnostic test kit, FIA680, FIA880" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={brandTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Migibio" />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={`${siteUrl}${ogImage}`} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={brandTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />}

    <meta name="generator" content={Astro.generator} />

    <!-- Schema.org JSON-LD -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <header class="sticky top-0 z-40 border-b border-gray-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2">
          <img src="/images/favicon.png" alt="Migibio logo" class="h-8 w-8" width="32" height="32" />
          <span class="text-lg font-bold text-brand-700">Migibio</span>
        </a>
        <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
          <div class="group relative">
            <button class="rounded px-3 py-2 text-sm font-medium text-gray-700 hover:bg-brand-50 hover:text-brand-700">About Us</button>
            <div class="invisible absolute left-0 top-full z-50 w-52 rounded-lg border border-gray-200 bg-white py-2 shadow-lg group-hover:visible">
              <a href="/about" class="block px-4 py-2 text-sm text-gray-700 hover:bg-brand-50">Introduction</a>
              <a href="/history" class="block px-4 py-2 text-sm text-gray-700 hover:bg-brand-50">History</a>
              <a href="/corporate-identity" class="block px-4 py-2 text-sm text-gray-700 hover:bg-brand-50">Corporate Identity</a>
              <a href="/locations" class="block px-4 py-2 text-sm text-gray-700 hover:bg-brand-50">Locations</a>
              <a href="/core-technology" class="block px-4 py-2 text-sm text-gray-700 hover:bg-brand-50">Core Technology</a>
            </div>
          </div>
          <div class="group relative">
            <button class="rounded px-3 py-2 text-sm font-medium text-gray-700 hover:bg-brand-50 hover:text-brand-700">Equipment</button>
            <div class="invisible absolute left-0 top-full z-50 w-44 rounded-lg border border-gray-200 bg-white py-2 shadow-lg group-hover:visible">
              <a href="/equipment/FIA680" class="block px-4 py-2 text-sm text-gray-700 hover:bg-brand-50">FIA680</a>
              <a href="/equipment/FIA880" class="block px-4 py-2 text-sm text-gray-700 hover:bg-brand-50">FIA880</a>
            </div>
          </div>
          <a href="/reagents" class="rounded px-3 py-2 text-sm font-medium text-gray-700 hover:bg-brand-50 hover:text-brand-700">Reagents</a>
          <a href="/core-technology" class="rounded px-3 py-2 text-sm font-medium text-gray-700 hover:bg-brand-50 hover:text-brand-700">Core Technology</a>
          <a href="/blog" class="rounded px-3 py-2 text-sm font-medium text-gray-700 hover:bg-brand-50 hover:text-brand-700">Blog</a>
          <a href="/support" class="rounded px-3 py-2 text-sm font-medium text-gray-700 hover:bg-brand-50 hover:text-brand-700">Support</a>
          <a href="/news" class="rounded px-3 py-2 text-sm font-medium text-gray-700 hover:bg-brand-50 hover:text-brand-700">News</a>
          <a href="/contact" class="rounded px-3 py-2 text-sm font-medium text-gray-700 hover:bg-brand-50 hover:text-brand-700">Contact Us</a>
        </nav>
        <a href="/contact" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">Request a Quote</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t border-gray-200 bg-gray-50">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3 lg:px-8">
        <div>
          <div class="flex items-center gap-2">
            <img src="/images/favicon.png" alt="Migibio logo" class="h-8 w-8" width="32" height="32" />
            <span class="text-lg font-bold text-brand-700">Migibio</span>
          </div>
          <p class="mt-3 text-sm text-gray-600">
            Leading manufacturer of POCT veterinary rapid diagnostic equipment and fluorescence immunochromatographic reagents.
          </p>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-gray-900">Products</h2>
          <ul class="mt-3 space-y-2 text-sm text-gray-600">
            <li><a href="/equipment/FIA680" class="hover:text-brand-700">FIA680 Analyzer</a></li>
            <li><a href="/equipment/FIA880" class="hover:text-brand-700">FIA880 Analyzer</a></li>
            <li><a href="/reagents" class="hover:text-brand-700">Canine &amp; Feline Reagents</a></li>
            <li><a href="/core-technology" class="hover:text-brand-700">Core Technology</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-gray-900">Contact Us</h2>
          <ul class="mt-3 space-y-2 text-sm text-gray-600">
            <li>Tel: {phone}</li>
            <li>Email: {email}</li>
            <li>{address}</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-gray-200 py-4 text-center text-xs text-gray-500">
        &copy; {new Date().getFullYear()} {companyName} — Migibio. All rights reserved.
      </div>
    </footer>
  </body>
</html>

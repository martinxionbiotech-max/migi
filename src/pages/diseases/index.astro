---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const diseases = await getCollection('diseases');

const speciesOrder = ['canine', 'feline'] as const;
const speciesLabels: Record<string, string> = {
  canine: 'Canine Diseases',
  feline: 'Feline Diseases',
};

const grouped = speciesOrder.map((species) => ({
  species,
  label: speciesLabels[species],
  items: diseases
    .filter((disease) => disease.data.species === species)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
}));

function firstSentence(text: string): string {
  const first = text.split('. ')[0];
  return `${first}.`;
}

const siteUrl = 'https://migibio.net';
const schema = {
  '@graph': [
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}/diseases/#list`,
      name: 'Canine & Feline Disease Reference',
      numberOfItems: diseases.length,
      itemListElement: diseases.map((d, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: d.data.title,
        url: `${siteUrl}/diseases/${d.data.slug}/`,
      })),
    },
  ],
};
---

<Layout
  title="Disease Hub — Canine & Feline Disease Reference"
  description="A structured canine and feline disease reference connected to Migibio biomarkers, test kits, and clinical articles."
  schema={schema}
  canonical="/diseases/"
  pageType="CollectionPage"
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Diseases' }]}
>
  <div class="bg-gradient-to-br from-brand-800 to-brand-600 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Disease Hub</h1>
      <p class="mt-3 max-w-3xl text-lg text-brand-100">
        A structured reference for canine and feline diseases supported by Migibio biomarkers, quantitative test kits, and related clinical articles.
      </p>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-3xl rounded-lg border border-brand-200 bg-brand-50 p-5 text-sm text-brand-900">
      <strong>Clinical note:</strong> this hub is an educational reference, not a substitute for veterinary judgement. Always interpret results with the patient's signalment, history, clinical signs, and the individual kit IFU.
    </div>

    <section class="mb-12">
      <h2 class="text-2xl font-bold text-gray-900">Browse by clinical discipline</h2>
      <p class="mt-2 max-w-3xl text-sm text-gray-600">
        Discipline hubs group diseases by the clinical question being asked — useful when the differential is unclear and you want the testing logic for a category rather than a single pathogen.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { label: 'Infectious disease', href: '/diseases/infectious/', note: 'Antigen vs antibody, panels, timing' },
          { label: 'Inflammatory', href: '/diseases/inflammatory/', note: 'CRP and SAA, magnitude and trend' },
          { label: 'Endocrine', href: '/diseases/endocrine/', note: 'Thyroid and adrenal pitfalls' },
          { label: 'Cardiac', href: '/diseases/cardiac/', note: 'NT-proBNP as a rule-out' },
          { label: 'Renal', href: '/diseases/renal/', note: 'Three markers, one narrow question' },
          { label: 'Pancreatic', href: '/diseases/pancreatic/', note: 'Composite diagnosis' },
          { label: 'Reproduction', href: '/diseases/reproduction/', note: 'Progesterone then relaxin' },
          { label: 'Vector-borne', href: '/diseases/vector-borne/', note: 'Clinical need and menu boundary' },
        ].map((hub) => (
          <a href={hub.href} class="group rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
            <h3 class="text-base font-semibold text-gray-900 group-hover:text-brand-700">{hub.label}</h3>
            <p class="mt-1 text-sm text-gray-600">{hub.note}</p>
          </a>
        ))}
      </div>
      <p class="mt-4 text-sm text-gray-600">
        Testing by species and life stage: <a href="/species/dogs/" class="text-brand-600 hover:text-brand-800">dogs</a> ·
        <a href="/species/cats/" class="text-brand-600 hover:text-brand-800">cats</a> ·
        <a href="/species/puppies/" class="text-brand-600 hover:text-brand-800">puppies</a> ·
        <a href="/species/kittens/" class="text-brand-600 hover:text-brand-800">kittens</a> ·
        <a href="/species/seniors/" class="text-brand-600 hover:text-brand-800">seniors</a>
      </p>
    </section>

    {grouped.map((group) => (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900">{group.label}</h2>
        {group.items.length === 0 ? (
          <p class="mt-3 text-gray-500">No diseases published for this species yet.</p>
        ) : (
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {group.items.map((disease) => (
              <a href={`/diseases/${disease.data.slug}`} class="group rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
                <div class="flex items-center justify-between gap-3">
                  <span class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">{group.label.replace(' Diseases', '')}</span>
                  <span class="text-xs text-gray-500">{disease.data.biomarkers.length} biomarker{disease.data.biomarkers.length === 1 ? '' : 's'}</span>
                </div>
                <h3 class="mt-4 text-lg font-semibold text-gray-900 group-hover:text-brand-700">{disease.data.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-gray-600 line-clamp-3">{firstSentence(disease.data.clinicalContext)}</p>
                <span class="mt-4 inline-flex items-center text-sm font-medium text-brand-600 group-hover:text-brand-800">View disease →</span>
              </a>
            ))}
          </div>
        )}
      </section>
    ))}
  </section>
</Layout>

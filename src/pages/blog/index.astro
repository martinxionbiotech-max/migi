---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
const sorted = posts
  .sort((a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0));

const siteUrl = 'https://migibio.net';
const schema = {
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${siteUrl}/blog/#blog`,
      name: 'Migibio Blog',
      url: `${siteUrl}/blog/`,
      description: 'Veterinary diagnostics insights, test guides, and technology deep-dives from Migibio.',
      publisher: { '@id': `${siteUrl}/#organization` },
      inLanguage: 'en',
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}/blog/#list`,
      name: 'Migibio Veterinary Diagnostics Articles',
      numberOfItems: sorted.length,
      itemListElement: sorted.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.data.title,
        url: `${siteUrl}/blog/${p.data.slug}/`,
      })),
    },
  ],
};

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

function categoryLabel(category: string | undefined): string {
  if (category === 'core-technology') return 'Core Technology';
  if (category === 'test-comparison') return 'Test Comparison';
  return 'Blog';
}
---

<Layout
  title="Blog — Veterinary Diagnostics Insights"
  description="Expert guides on feline and canine disease testing, veterinary rapid diagnostics, and fluorescence immunochromatography technology."
  schema={schema}
  canonical="/blog/"
  pageType="CollectionPage"
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Blog' }]}
>
  <div class="bg-gradient-to-br from-brand-800 to-brand-600 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Blog</h1>
      <p class="mt-3 text-lg text-brand-100">Veterinary diagnostics insights and technology deep-dives.</p>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sorted.map((post) => (
        <a href={`/blog/${post.data.slug}`} class="group rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="text-xs font-medium uppercase tracking-wide text-brand-600">
            {categoryLabel(post.data.category)}
          </div>
          <h2 class="mt-2 text-lg font-semibold text-gray-900 line-clamp-2 group-hover:text-brand-700">{post.data.title}</h2>
          <div class="mt-2 text-xs text-gray-500">{post.data.pubDate && <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>}</div>
          {post.data.description && <p class="mt-3 text-sm text-gray-600 line-clamp-3">{post.data.description}</p>}
          <span class="mt-4 inline-flex items-center text-sm font-medium text-brand-600 group-hover:text-brand-800">Read article →</span>
        </a>
      ))}
    </div>
  </section>
</Layout>

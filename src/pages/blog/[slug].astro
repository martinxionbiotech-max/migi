---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({
    params: { slug: p.data.slug },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { title, description, pubDate, category, faq } = entry.data;

const { Content } = await render(entry);

const pageUrl = `/blog/${entry.data.slug}/`;
const siteUrl = 'https://migibio.net';
const isComparison = category === 'test-comparison';
// dateModified 取该内容文件在 git 中的最后提交日期（真实、可核验），不臆造
const contentDates = (await import('../../data/content-dates.json')).default as Record<string, string>;
const dateModified = contentDates[`blog/${entry.data.slug}`];
const datePublished = pubDate ? pubDate.toISOString().slice(0, 10) : undefined;
const articleSchema = {
  '@graph': [
    {
      '@type': isComparison ? 'WebPage' : 'Article',
      '@id': `${siteUrl}${pageUrl}#article`,
      headline: title,
      description: description || title,
      url: `${siteUrl}${pageUrl}`,
      ...(datePublished ? { datePublished } : {}),
      ...(dateModified ? { dateModified } : {}),
      inLanguage: 'en',
      isPartOf: { '@id': `${siteUrl}/#website` },
      author: {
        '@type': 'Person',
        '@id': `${siteUrl}/author-dr-tang#person`,
        name: 'Dr. Tang',
        url: `${siteUrl}/author-dr-tang`,
        jobTitle: 'Veterinary Diagnostics Specialist, Guangzhou Magic Biotech Co., Ltd.',
        alumniOf: { '@type': 'CollegeOrUniversity', name: 'Southern Medical University' },
        worksFor: { '@id': `${siteUrl}/#organization` },
      },
      publisher: { '@id': `${siteUrl}/#organization` },
      mainEntityOfPage: { '@id': `${siteUrl}${pageUrl.replace(/\/$/, '')}/#webpage` },
      ...(category ? { articleSection: categoryLabel(category) } : {}),
    },
    ...(faq
      ? [{
          '@type': 'FAQPage',
          mainEntity: faq.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        }]
      : []),
  ],
};

function categoryLabel(category: string | undefined): string {
  if (category === 'core-technology') return 'Core Technology';
  if (category === 'test-comparison') return 'Test Comparison';
  return 'Blog';
}

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout
  title={title}
  description={description}
  schema={articleSchema}
  type={isComparison ? 'website' : 'article'}
  canonical={pageUrl}
  pageType="ItemPage"
  datePublished={datePublished}
  dateModified={dateModified}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog/' },
    { name: title },
  ]}
>
  <article class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <nav class="mb-6 text-sm text-gray-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/blog" class="hover:text-brand-600">Blog</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{title}</span>
    </nav>

    <header class="mb-8 border-b border-gray-200 pb-6">
      {category && (
        <span class="text-xs font-medium uppercase tracking-wide text-brand-600">
          {categoryLabel(category)}
        </span>
      )}
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">{title}</h1>
      {pubDate && <p class="mt-3 text-sm text-gray-500"><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · By <a href="/author-dr-tang" class="font-medium text-brand-600 hover:text-brand-800">Dr. Tang</a></p>}
    </header>

    <div class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-a:text-brand-600 prose-table:border-collapse prose-th:border prose-th:border-gray-300 prose-th:bg-gray-50 prose-th:px-4 prose-th:py-2 prose-td:border prose-td:border-gray-300 prose-td:px-4 prose-td:py-2">
      <Content />
    </div>
  </article>
</Layout>

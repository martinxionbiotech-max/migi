---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const biomarkers = await getCollection('biomarkers');
  return biomarkers.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, description, species, biomarker, method, unit, category, clinicalContext, referenceRange, source, date, confidence, relatedProducts, relatedBlogs, faq } = entry.data;

const products = await getCollection('products');
const blogs = await getCollection('blog');

const relatedProductEntries = relatedProducts
  .map((slug) => products.find((product) => product.data.slug === slug))
  .filter((entry) => entry);

const relatedBlogEntries = relatedBlogs
  .map((slug) => blogs.find((post) => post.data.slug === slug))
  .filter((entry) => entry);

const categoryLabels: Record<string, string> = {
  infectious: 'Infectious Disease',
  endocrine: 'Endocrine',
  inflammatory: 'Inflammatory',
  cardiac: 'Cardiac',
  pancreatic: 'Pancreatic',
  renal: 'Renal',
};

function speciesLabel(value: 'canine' | 'feline' | 'both'): string {
  return value === 'both' ? 'Canine & Feline' : value === 'canine' ? 'Canine' : 'Feline';
}

const pageUrl = `/biomarkers/${entry.data.slug}/`;
const pageSchema = {
  '@graph': [
    ...(faq
      ? [{
          '@type': 'FAQPage',
          mainEntity: faq.map((item) => ({
            '@type': 'Question',
            name: item.q,
            acceptedAnswer: { '@type': 'Answer', text: item.a },
          })),
        }]
      : []),
  ],
};
---

<Layout
  title={title}
  description={description}
  schema={pageSchema}
  canonical={pageUrl}
  pageType="WebPage"
  dateModified={date}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Biomarkers', url: '/biomarkers/' },
    { name: title },
  ]}
>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <nav class="mb-6 text-sm text-gray-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/biomarkers" class="hover:text-brand-600">Biomarkers</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{title}</span>
    </nav>

    <header class="mb-8 border-b border-gray-200 pb-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">{speciesLabel(species)}</span>
        <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">{categoryLabels[category]}</span>
      </div>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-gray-600">{clinicalContext}</p>
    </header>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900">Fact Table</h2>
      <div class="mt-4 overflow-hidden rounded-lg border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200">
          <tbody class="divide-y divide-gray-200 bg-white">
            <tr>
              <th scope="row" class="w-1/3 bg-gray-50 px-4 py-3 text-left font-semibold text-gray-700">Species</th>
              <td class="px-4 py-3 text-gray-600">{speciesLabel(species)}</td>
            </tr>
            <tr>
              <th scope="row" class="w-1/3 bg-gray-50 px-4 py-3 text-left font-semibold text-gray-700">Biomarker</th>
              <td class="px-4 py-3 text-gray-600">{biomarker}</td>
            </tr>
            <tr>
              <th scope="row" class="w-1/3 bg-gray-50 px-4 py-3 text-left font-semibold text-gray-700">Method</th>
              <td class="px-4 py-3 text-gray-600">{method}</td>
            </tr>
            <tr>
              <th scope="row" class="w-1/3 bg-gray-50 px-4 py-3 text-left font-semibold text-gray-700">Unit</th>
              <td class="px-4 py-3 text-gray-600">{unit}</td>
            </tr>
            <tr>
              <th scope="row" class="w-1/3 bg-gray-50 px-4 py-3 text-left font-semibold text-gray-700">Category</th>
              <td class="px-4 py-3 text-gray-600">{categoryLabels[category]}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-xl font-bold text-gray-900">Clinical Context</h2>
      <p class="mt-3 text-gray-700">{clinicalContext}</p>
      <p class="mt-3 text-gray-700">
        Interpretation should always combine the quantitative result with the patient's signalment, history, clinical signs, and any other laboratory findings. A single value is rarely diagnostic on its own; serial measurements often provide more useful information.
      </p>
    </section>

    <section class="mb-10 rounded-lg border border-brand-200 bg-brand-50 p-5">
      <h2 class="text-xl font-bold text-brand-900">Reference Range</h2>
      <p class="mt-3 text-brand-900">{referenceRange}</p>
    </section>

    {relatedProductEntries.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-bold text-gray-900">Related Test Kits</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {relatedProductEntries.map((product) => (
            <li>
              <a href={`/reagents/${product.data.slug}`} class="block rounded-lg border border-gray-200 bg-white p-4 text-sm font-medium text-gray-800 shadow-sm transition-colors hover:border-brand-300 hover:text-brand-700">
                {product.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {relatedBlogEntries.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xl font-bold text-gray-900">Related Articles</h2>
        <ul class="mt-4 space-y-3">
          {relatedBlogEntries.map((post) => (
            <li>
              <a href={`/blog/${post.data.slug}`} class="block rounded-lg border border-gray-200 bg-white p-4 shadow-sm transition-colors hover:border-brand-300">
                <span class="font-semibold text-gray-900 hover:text-brand-700">{post.data.title}</span>
                {post.data.description && <span class="mt-1 block text-sm text-gray-600">{post.data.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mb-10 grid gap-4 text-sm text-gray-600 sm:grid-cols-3">
      <div class="rounded-lg border border-gray-200 bg-white p-4"><strong class="text-gray-900">Source</strong><p class="mt-1">{source}</p></div>
      <div class="rounded-lg border border-gray-200 bg-white p-4"><strong class="text-gray-900">Date</strong><p class="mt-1">{date}</p></div>
      <div class="rounded-lg border border-gray-200 bg-white p-4"><strong class="text-gray-900">Confidence</strong><p class="mt-1">{confidence}</p></div>
    </section>

    {faq && faq.length > 0 && (
      <section>
        <h2 class="text-xl font-bold text-gray-900">FAQ</h2>
        <div class="mt-4 space-y-4">
          {faq.map((item) => (
            <div class="rounded-lg border border-gray-200 bg-white p-5">
              <h3 class="font-semibold text-gray-900">{item.q}</h3>
              <p class="mt-2 text-gray-700">{item.a}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const products = await getCollection('products');
const reagents = products
  .filter((p) => p.data.category === 'canine-feline')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const canine = reagents.filter((p) => /dog|canine/i.test(p.data.title));
const feline = reagents.filter((p) => /cat|feline/i.test(p.data.title));
const shared = reagents.filter((p) => !canine.includes(p) && !feline.includes(p));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Reagents',
      description: 'Canine and feline rapid quantitative test reagents for veterinary diagnostics.',
      url: 'https://migibio.com/reagents',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://migibio.com/' },
        { '@type': 'ListItem', position: 2, name: 'Reagents' },
      ],
    },
  ],
};
---

<Layout title="Reagents — Canine & Feline Rapid Quantitative Test Kits" description="Rapid quantitative fluorescence immunochromatographic test reagents for canine and feline disease detection — antigens, antibodies, hormones, and biomarkers." schema={schema}>
  <div class="bg-gradient-to-br from-brand-800 to-brand-600 text-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Reagents</h1>
      <p class="mt-3 text-lg text-brand-100">Canine &amp; feline rapid quantitative test kits for fluorescence immunoassay analyzers.</p>
    </div>
  </div>

  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- 分类概览 -->
    <div class="mb-12 max-w-3xl">
      <h2 class="text-2xl font-bold text-gray-900">Complete Canine &amp; Feline Diagnostic Coverage</h2>
      <p class="mt-4 text-gray-600">
        Every Migibio reagent uses quantitative fluorescence immunochromatography (FICT) to deliver objective, instrument-read concentrations — not a subjective line — with pg/ml-level sensitivity and CV% below 10%. Simply add the specimen, insert the device, and read the result on the FIA680 or FIA880 analyzer in minutes.
      </p>
    </div>

    <!-- Canine -->
    {canine.length > 0 && (
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900">Canine Test Kits</h2>
        <p class="mt-2 max-w-3xl text-gray-600">
          Canine reagents cover infectious disease antigens and antibodies (parvovirus, distemper, coronavirus, adenovirus), reproductive hormones (progesterone, relaxin), endocrine markers (cortisol, total T4, TSH), inflammation (CRP), and organ-function biomarkers (SDMA, cystatin C, NT-proBNP, pancreatic lipase, Leishmania, Toxoplasma).
        </p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {canine.map((p) => (
            <a href={`/reagents/${p.data.slug}`} class="group overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
              <div class="aspect-square overflow-hidden bg-gray-100">
                {p.data.image ? (
                  <img src={p.data.image} alt={p.data.title} class="h-full w-full object-contain p-4 transition-transform group-hover:scale-105" loading="lazy" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-brand-50"><span class="text-5xl text-brand-300">🧪</span></div>
                )}
              </div>
              <div class="p-4">
                {p.data.catNo && <span class="text-xs font-medium uppercase tracking-wide text-brand-600">{p.data.catNo}</span>}
                <h3 class="mt-1 text-base font-semibold text-gray-900 line-clamp-2 group-hover:text-brand-700">{p.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Feline -->
    {feline.length > 0 && (
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900">Feline Test Kits</h2>
        <p class="mt-2 max-w-3xl text-gray-600">
          Feline reagents cover infectious disease antigens and antibodies (panleukopenia, calicivirus, herpesvirus, coronavirus, leukaemia virus, immunodeficiency virus), endocrine markers (total T4), inflammation (SAA), and organ-function biomarkers (SDMA, cystatin C, pancreatic lipase, NT-proBNP).
        </p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {feline.map((p) => (
            <a href={`/reagents/${p.data.slug}`} class="group overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
              <div class="aspect-square overflow-hidden bg-gray-100">
                {p.data.image ? (
                  <img src={p.data.image} alt={p.data.title} class="h-full w-full object-contain p-4 transition-transform group-hover:scale-105" loading="lazy" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-brand-50"><span class="text-5xl text-brand-300">🧪</span></div>
                )}
              </div>
              <div class="p-4">
                {p.data.catNo && <span class="text-xs font-medium uppercase tracking-wide text-brand-600">{p.data.catNo}</span>}
                <h3 class="mt-1 text-base font-semibold text-gray-900 line-clamp-2 group-hover:text-brand-700">{p.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Shared -->
    {shared.length > 0 && (
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900">Canine &amp; Feline Shared Biomarkers</h2>
        <p class="mt-2 max-w-3xl text-gray-600">
          Shared biomarkers applicable to both dogs and cats, including SDMA for early detection and IRIS staging of chronic kidney disease.
        </p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {shared.map((p) => (
            <a href={`/reagents/${p.data.slug}`} class="group overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
              <div class="aspect-square overflow-hidden bg-gray-100">
                {p.data.image ? (
                  <img src={p.data.image} alt={p.data.title} class="h-full w-full object-contain p-4 transition-transform group-hover:scale-105" loading="lazy" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-brand-50"><span class="text-5xl text-brand-300">🧪</span></div>
                )}
              </div>
              <div class="p-4">
                {p.data.catNo && <span class="text-xs font-medium uppercase tracking-wide text-brand-600">{p.data.catNo}</span>}
                <h3 class="mt-1 text-base font-semibold text-gray-900 line-clamp-2 group-hover:text-brand-700">{p.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</Layout>
